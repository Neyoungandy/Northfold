<div class="nf-drawer" data-nf-drawer aria-hidden="true">
  <button
    type="button"
    class="nf-drawer__overlay"
    data-nf-drawer-close
    aria-label="{{ 'cart.close' | t }}"
  ></button>

  <aside
    class="nf-drawer__panel"
    data-nf-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="nf-drawer-title-{{ section.id }}"
    tabindex="-1"
  >
    <div class="nf-drawer__head">
      <h2 id="nf-drawer-title-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <button type="button" class="nf-drawer__close" data-nf-drawer-close>
        {{ 'cart.close' | t }}
      </button>
    </div>

    {% if cart.item_count == 0 %}
      <p class="nf-drawer__empty">{{ 'cart.empty' | t }}</p>
    {% else %}
      <ul class="nf-drawer__list">
        {% for item in cart.items %}
          <li class="nf-drawer__item">
            {% if item.image %}
              {% assign item_alt = item.image.alt | default: item.product.title %}
              <a href="{{ item.url }}">
                {{
                  item.image
                  | image_url: width: 200
                  | image_tag:
                    widths: '100, 200',
                    sizes: '72px',
                    alt: item_alt
                }}
              </a>
            {% endif %}
            <div>
              <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
              <p>{{ 'cart.quantity' | t }}: {{ item.quantity }}</p>
              <p>{{ item.final_line_price | money }}</p>
            </div>
          </li>
        {% endfor %}
      </ul>

      <p class="nf-drawer__total">{{ cart.total_price | money }}</p>
      <a class="nf-drawer__checkout" href="{{ routes.checkout_url }}">{{ 'cart.checkout' | t }}</a>
    {% endif %}
  </aside>
</div>

{% stylesheet %}
  .nf-drawer {
    position: fixed;
    inset: 0;
    z-index: 40;
    pointer-events: none;
  }

  .nf-drawer.is-open {
    pointer-events: auto;
  }

  .nf-drawer__overlay {
    position: absolute;
    inset: 0;
    border: 0;
    padding: 0;
    background: rgba(44, 40, 36, 0.45);
    opacity: 0;
    cursor: pointer;
  }

  .nf-drawer.is-open .nf-drawer__overlay {
    opacity: 1;
  }

  .nf-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: min(22rem, 100%);
    height: 100%;
    padding: 1.25rem;
    overflow: auto;
    background: #fbf8f3;
    color: #2c2824;
    font-family: Georgia, "Palatino Linotype", Palatino, serif;
    transform: translateX(100%);
  }

  .nf-drawer.is-open .nf-drawer__panel {
    transform: none;
  }

  .nf-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nf-drawer__head h2 {
    margin: 0;
    font-size: 1.3rem;
    font-weight: normal;
  }

  .nf-drawer__close {
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .nf-drawer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nf-drawer__item {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid #d9d0c4;
  }

  .nf-drawer__item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .nf-drawer__item a {
    color: inherit;
  }

  .nf-drawer__item p {
    margin: 0.2rem 0 0;
    color: #6a6158;
  }

  .nf-drawer__empty,
  .nf-drawer__total {
    margin: 0;
  }

  .nf-drawer__checkout {
    display: inline-block;
    padding: 0.8rem 1.4rem;
    background: #2c2824;
    color: #fbf8f3;
    text-decoration: none;
  }
{% endstylesheet %}

{% javascript %}
  var drawer = document.querySelector('[data-nf-drawer]');
  if (drawer) {
    function openDrawer() {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      var panel = drawer.querySelector('[data-nf-drawer-panel]');
      if (panel) {
        panel.focus();
      }
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
    }

    document.addEventListener('nf:cart-added', openDrawer);

    document.addEventListener('click', function (event) {
      if (event.target.closest('[data-nf-drawer-close]')) {
        closeDrawer();
      }
    });

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') {
        if (drawer.classList.contains('is-open')) {
          closeDrawer();
        }
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Cart drawer",
  "tag": "div",
  "class": "northfold-cart-drawer",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Cart"
    }
  ]
}
{% endschema %}
